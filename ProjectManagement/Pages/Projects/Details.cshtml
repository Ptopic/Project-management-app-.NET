@page
@using TaskStatus = ProjectManagement.Entities.Enums.TaskStatus
@model ProjectManagement.Pages.Projects.Details

@{
    var keyword = ViewData["Keyword"] as string;
    var currentFilter = ViewData["CurrentFilter"] as string;
}


<div class="px-4">
    <h2>@Model.Project.Name</h2>

    <div class="flex flex-row align-middle justify-content-between gap-3 pb-4">
        <form asp-action="OnGetAsync" method="get">
            <input type="hidden" name="id" value="@Model.Project.Id" />
            <div class="row flex flex-row align-middle">
                <div class="input-group" style="width: fit-content">
                    <input type="search" class="form-control w-25" placeholder="Search..." name="searchString" value="@keyword">

                    <select class="form-select w-25" name="currentFilter">
                        <option value="">All</option>
                        <option value="unassigned" selected="@(currentFilter == "unassigned")">Unassigned</option>
                        @foreach (var user in @Model.UserOptions)
                        {
                            <option value="@user.Id" selected="@(user.Id == currentFilter)">@user.FirstName @user.LastName (@user.Email)</option>
                        }
                    </select>
                    
                    <button type="submit" class="btn btn-primary mr-2"><i class="bi bi-search"></i></button>
                    <a asp-action="OnGetAsync" asp-route-id="@Model.Project.Id" class="btn btn-secondary clear-btn">Clear</a>
                </div>
                <div style="width: fit-content" class="flex flex-column align-middle justify-content-center">
                    <p class="mb-0 flex flex-row align-middle justify-content-center" style="width: fit-content; height: fit-content">Members: <b>@Model.MemberCount</b></p>
                </div>
            </div>
        </form>
    </div>
    
    <div class="container-fluid">
        <div class="row gap-3">
            @* TODO Tasks *@
            <div class="col rounded-1" style="background: #f7f8f9">
                @if (Model.TODOTasks.Any())
                {
                    <p class="pt-2" style="font-size: 14px; font-weight: 700">TODO <span>(@Model.TODOTasks.Count())</span></p>
                }
                else
                {
                    <p class="pt-2" style="font-size: 14px; font-weight: 700">TODO <span>0</span></p>
                }
                <div class="d-flex flex-column gap-2" style="padding-bottom: 16px">
                    @if (Model.TODOTasks.Any())
                    {
                        @foreach (var task in @Model.TODOTasks)
                        {
                            <div class="bg-white shadow-sm rounded-1" style="padding: 12px">
                                <div class="d-flex flex-row align-items-center justify-content-between">
                                    <a asp-page="/Tasks/Details" asp-route-id="@task.Id" asp-route-projectId="@Model.Project.Id">
                                        @task.Name
                                    </a>

                                    <form asp-page-handler="RemoveTask" method="post" class="w-auto">
                                        <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <button class="btn btn-danger" style="transform: scale(0.8); padding: 5px 10px"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                                <div class="d-flex flex-row justify-content-between align-items-end">
                                    <div class="d-flex flex-row gap-1 align-items-center justify-content-center" style="width: fit-content;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#ffffff" class="bi bi-check rounded-1" viewBox="0 0 16 16" style="background: #007bff">
                                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                                        </svg>
                                        <p class="mb-0" style="font-size: 14px; font-weight: 600">@task.TaskIdentifier</p>
                                    </div>
                                    <form asp-page-handler="AssignUserToTask" method="post" id="assigneeForm-@task.Id">
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <input type="hidden" name="projectId" value="@Model.Project.Id"/>
                                        <select class="form-select" name="userId" style="width: fit-content" onchange="document.getElementById('assigneeForm-@task.Id').submit()">
                                            <option value="null">Unassigned</option>
                                            @foreach (var user in @Model.UserOptions)
                                            {
                                            <option value="@user.Id" selected="@(user == task.Assignee)">@user.Email</option>
                                            }
                                        </select>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    <div class="bg-white shadow-sm rounded-1 create-new-task-box todo" style="padding: 12px">
                        <div class="d-flex flex-row justify-content-between">
                            <p class="mb-2" style="font-weight: 600">Create new task</p>
                            <button class="create-task-close-btn todo">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                                </svg>
                            </button>
                        </div>
                        <form id="create-task-form-todo" method="post" enctype="multipart/form-data">
                            <input asp-for="Input.Name" type="text" class="create-new-task-input w-100 border-0" placeholder="What needs to be done?" onkeypress="submitOnEnterTodo(event)"/>
                            <input asp-for="Input.Status" type="text" value="TODO" class="d-none"/>
                        </form>
                    </div>
                </div>
                <p class="create-new-task todo" style="font-weight: 600"><i class="bi bi-plus-lg"></i> Create task</p>
            </div>

            @* IN PROGRESS Tasks *@
            <div class="col rounded-1" style="background: #f7f8f9">
                @if (Model.INPROGRESSTasks.Any())
                {
                <p class="pt-2" style="font-size: 14px; font-weight: 700">IN PROGRESS <span>(@Model.INPROGRESSTasks.Count())</span></p>
                }
                else
                {
                <p class="pt-2" style="font-size: 14px; font-weight: 700">IN PROGRESS <span>0</span></p>
                }
                <div class="d-flex flex-column gap-2" style="padding-bottom: 16px">
                    @if (Model.INPROGRESSTasks.Any())
                    {
                        @foreach (var task in @Model.INPROGRESSTasks)
                        {
                            <div class="bg-white shadow-sm rounded-1" style="padding: 12px">
                                <div class="d-flex flex-row align-items-center justify-content-between">
                                    <a asp-page="/Tasks/Details" asp-route-id="@task.Id" asp-route-projectId="@Model.Project.Id">
                                        @task.Name
                                    </a>

                                    <form asp-page-handler="RemoveTask" method="post" class="w-auto">
                                        <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <button class="btn btn-danger" style="transform: scale(0.8); padding: 5px 10px"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                                <div class="d-flex flex-row justify-content-between">
                                    <div class="d-flex flex-row gap-1 align-items-center justify-content-center" style="width: fit-content;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#ffffff" class="bi bi-check rounded-1" viewBox="0 0 16 16" style="background: #007bff">
                                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                                        </svg>
                                        <p class="mb-0" style="font-size: 14px; font-weight: 600">@task.TaskIdentifier</p>
                                    </div>
                                    <form asp-page-handler="AssignUserToTask" method="post" id="assigneeForm-@task.Id">
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <input type="hidden" name="projectId" value="@Model.Project.Id"/>
                                        <select class="form-select" name="userId" style="width: fit-content" onchange="document.getElementById('assigneeForm-@task.Id').submit()">
                                            <option value="null">Unassigned</option>
                                            @foreach (var user in @Model.UserOptions)
                                            {
                                            <option value="@user.Id" selected="@(user == task.Assignee)">@user.Email</option>
                                            }
                                        </select>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    <div class="bg-white shadow-sm rounded-1 create-new-task-box inprogress" style="padding: 12px">
                        <div class="d-flex flex-row justify-content-between">
                            <p class="mb-2" style="font-weight: 600">Create new task</p>
                            <button class="create-task-close-btn inprogress">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                                </svg>
                            </button>
                        </div>
                        <form id="create-task-form-inprogress" method="post" enctype="multipart/form-data">
                            <input asp-for="Input.Name" type="text" class="create-new-task-input w-100 border-0" placeholder="What needs to be done?" onkeypress="submitOnEnterInProgress(event)"/>
                            <input asp-for="Input.Status" type="text" value="IN_PROGRESS" class="d-none"/>
                        </form>
                    </div>
                </div>
                <p class="create-new-task inprogress" style="font-weight: 600"><i class="bi bi-plus-lg"></i> Create task</p>
            </div>

            @* IN REVIEW Tasks *@
            <div class="col rounded-1" style="background: #f7f8f9">
                @if (Model.INREVIEWTasks.Any())
                {
                <p class="pt-2" style="font-size: 14px; font-weight: 700">IN REVIEW <span>(@Model.INREVIEWTasks.Count())</span></p>
                }
                else
                {
                <p class="pt-2" style="font-size: 14px; font-weight: 700">IN REVIEW <span>0</span></p>
                }
                <div class="d-flex flex-column gap-2" style="padding-bottom: 16px">
                    @if (Model.INREVIEWTasks.Any())
                    {
                        @foreach (var task in @Model.INREVIEWTasks)
                        {
                            <div class="bg-white shadow-sm rounded-1" style="padding: 12px">
                                <div class="d-flex flex-row align-items-center justify-content-between">
                                    <a asp-page="/Tasks/Details" asp-route-id="@task.Id" asp-route-projectId="@Model.Project.Id">
                                        @task.Name
                                    </a>

                                    <form asp-page-handler="RemoveTask" method="post" class="w-auto">
                                        <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <button class="btn btn-danger" style="transform: scale(0.8); padding: 5px 10px"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                                <div class="d-flex flex-row justify-content-between">
                                    <div class="d-flex flex-row gap-1 align-items-center justify-content-center" style="width: fit-content;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#ffffff" class="bi bi-check rounded-1" viewBox="0 0 16 16" style="background: #007bff">
                                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                                        </svg>
                                        <p class="mb-0" style="font-size: 14px; font-weight: 600">@task.TaskIdentifier</p>
                                    </div>
                                    <form asp-page-handler="AssignUserToTask" method="post" id="assigneeForm-@task.Id">
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <input type="hidden" name="projectId" value="@Model.Project.Id"/>
                                        <select class="form-select" name="userId" style="width: fit-content" onchange="document.getElementById('assigneeForm-@task.Id').submit()">
                                            <option value="null">Unassigned</option>
                                            @foreach (var user in @Model.UserOptions)
                                            {
                                            <option value="@user.Id" selected="@(user == task.Assignee)">@user.Email</option>
                                            }
                                        </select>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    <div class="bg-white shadow-sm rounded-1 create-new-task-box inreview" style="padding: 12px">
                        <div class="d-flex flex-row justify-content-between">
                            <p class="mb-2" style="font-weight: 600">Create new task</p>
                            <button class="create-task-close-btn inreview">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                                </svg>
                            </button>
                        </div>
                        <form id="create-task-form-inreview" method="post" enctype="multipart/form-data">
                            <input asp-for="Input.Name" type="text" class="create-new-task-input w-100 border-0" placeholder="What needs to be done?" onkeypress="submitOnEnterInReview(event)"/>
                            <input asp-for="Input.Status" type="text" value="IN_REVIEW" class="d-none"/>
                        </form>
                    </div>
                </div>
                <p class="create-new-task inreview" style="font-weight: 600"><i class="bi bi-plus-lg"></i> Create task</p>
            </div>

            @* DONE Tasks *@
            <div class="col rounded-1" style="background: #f7f8f9">
                @if (Model.DONETasks.Any())
                {
                <p class="pt-2" style="font-size: 14px; font-weight: 700">DONE <span>(@Model.DONETasks.Count())</span></p>
                }
                else
                {
                <p class="pt-2" style="font-size: 14px; font-weight: 700">DONE <span>0</span></p>
                }
                <div class="d-flex flex-column gap-2" style="padding-bottom: 16px">
                    @if (Model.DONETasks.Any())
                    {
                        @foreach (var task in @Model.DONETasks)
                        {
                            <div class="bg-white shadow-sm rounded-1" style="padding: 12px">
                                <div class="d-flex flex-row align-items-center justify-content-between">
                                    <a asp-page="/Tasks/Details" asp-route-id="@task.Id" asp-route-projectId="@Model.Project.Id">
                                        @task.Name
                                    </a>

                                    <form asp-page-handler="RemoveTask" method="post" class="w-auto">
                                        <input type="hidden" name="projectId" value="@Model.Project.Id" />
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <button class="btn btn-danger" style="transform: scale(0.8); padding: 5px 10px"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                                <div class="d-flex flex-row justify-content-between">
                                    <div class="d-flex flex-row gap-1 align-items-center justify-content-center" style="width: fit-content;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#ffffff" class="bi bi-check rounded-1" viewBox="0 0 16 16" style="background: #007bff">
                                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                                        </svg>
                                        <p class="mb-0" style="font-size: 14px; font-weight: 600">@task.TaskIdentifier</p>
                                    </div>
                                    <form asp-page-handler="AssignUserToTask" method="post" id="assigneeForm-@task.Id">
                                        <input type="hidden" name="taskId" value="@task.Id"/>
                                        <input type="hidden" name="projectId" value="@Model.Project.Id"/>
                                        <select class="form-select" name="userId" style="width: fit-content" onchange="document.getElementById('assigneeForm-@task.Id').submit()">
                                            <option value="null">Unassigned</option>
                                            @foreach (var user in @Model.UserOptions)
                                            {
                                            <option value="@user.Id" selected="@(user == task.Assignee)">@user.Email</option>
                                            }
                                        </select>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    <div class="bg-white shadow-sm rounded-1 create-new-task-box done" style="padding: 12px">
                        <div class="d-flex flex-row justify-content-between">
                            <p class="mb-2" style="font-weight: 600">Create new task</p>
                            <button class="create-task-close-btn done">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x" viewBox="0 0 16 16">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                                </svg>
                            </button>
                        </div>
                        <form id="create-task-form-done" method="post" enctype="multipart/form-data">
                            <input asp-for="Input.Name" type="text" class="create-new-task-input w-100 border-0" placeholder="What needs to be done?" onkeypress="submitOnEnterDone(event)"/>
                            <input asp-for="Input.Status" type="text" value="DONE" class="d-none"/>
                        </form>
                    </div>
                </div>
                <p class="create-new-task done" style="font-weight: 600"><i class="bi bi-plus-lg"></i> Create task</p>
            </div>
        </div>
    </div>
</div>

<style>
    .create-new-task-box {
        display: none;
        transition: all .2s ease-in-out;
        border: 2px solid #007bff;
    }
    .create-new-task {
        padding: 8px;
        border-radius: 6px;
        transition: all .2s ease-in-out;
    }
    .create-new-task:hover {
        background: #e9ebee;
        cursor: pointer;
    }
    .create-new-task-input {
        border: none;
    }
    .create-new-task-input:focus {
        outline: none;
    }
    .create-task-close-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }
</style>

<script>
    function submitOnEnterTodo(event) {
        if (event.key === "Enter") {
            event.preventDefault();
            document.getElementById('create-task-form-todo').submit();
        }
    }

    function submitOnEnterInProgress(event) {
        if (event.key === "Enter") {
            event.preventDefault();
            document.getElementById('create-task-form-inprogress').submit();
        }
    }

    function submitOnEnterInReview(event) {
        if (event.key === "Enter") {
            event.preventDefault();
            document.getElementById('create-task-form-inreview').submit();
        }
    }

    function submitOnEnterDone(event) {
        if (event.key === "Enter") {
            event.preventDefault();
            document.getElementById('create-task-form-done').submit();
        }
    }
    
    // Create task button TODO
    const createTaskButtonTodo = document.querySelector('.create-new-task.todo');
    const createTaskBoxTodo = document.querySelector('.create-new-task-box.todo');
    const closeTaskButtonTodo = document.querySelector('.create-task-close-btn.todo');

    createTaskButtonTodo.addEventListener('click', function () {
        createTaskBoxTodo.style.display = 'block';
        createTaskButtonTodo.style.display = 'none';
    });

    closeTaskButtonTodo.addEventListener('click', function () {
        createTaskBoxTodo.style.display = 'none';
        createTaskButtonTodo.style.display = 'block';
    });

    // Create task button IN PROGRESS
    const createTaskButtonInProgress = document.querySelector('.create-new-task.inprogress');
    const createTaskBoxInProgress = document.querySelector('.create-new-task-box.inprogress');
    const closeTaskButtonInProgress = document.querySelector('.create-task-close-btn.inprogress');

    createTaskButtonInProgress.addEventListener('click', function () {
        createTaskBoxInProgress.style.display = 'block';
        createTaskButtonInProgress.style.display = 'none';
    });

    closeTaskButtonInProgress.addEventListener('click', function () {
        createTaskBoxInProgress.style.display = 'none';
        createTaskButtonInProgress.style.display = 'block';
    });

    // Create task button IN REVIEW
    const createTaskButtonInReview = document.querySelector('.create-new-task.inreview');
    const createTaskBoxInReview = document.querySelector('.create-new-task-box.inreview');
    const closeTaskButtonInReview = document.querySelector('.create-task-close-btn.inreview');

    createTaskButtonInReview.addEventListener('click', function () {
        createTaskBoxInReview.style.display = 'block';
        createTaskButtonInReview.style.display = 'none';
    });

    closeTaskButtonInReview.addEventListener('click', function () {
        createTaskBoxInReview.style.display = 'none';
        createTaskButtonInReview.style.display = 'block';
    });

    // Create task button DONE
    const createTaskButtonDone = document.querySelector('.create-new-task.done');
    const createTaskBoxDone = document.querySelector('.create-new-task-box.done');
    const closeTaskButtonDone = document.querySelector('.create-task-close-btn.done');

    createTaskButtonDone.addEventListener('click', function () {
        createTaskBoxDone.style.display = 'block';
        createTaskButtonDone.style.display = 'none';
    });

    closeTaskButtonDone.addEventListener('click', function () {
        createTaskBoxDone.style.display = 'none';
        createTaskButtonDone.style.display = 'block';
    });

</script>